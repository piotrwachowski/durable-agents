# OpenAI — required
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# OPENAI_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=4096
# TEMPORAL_HOST=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=durable-agents
# CONTEXT_LIMIT=6000
# DURABLE_AGENT_MAX_STEPS=20

# Local / OpenAI-compatible models (Ollama, vLLM). When OPENAI_BASE_URL is set,
# OPENAI_API_KEY becomes optional (local servers ignore it). See docs/12-local-models.md.
# Include the quantization tag — these models have no :latest tag.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=SpeakLeash/bielik-11b-v3.0-instruct:Q8_0
